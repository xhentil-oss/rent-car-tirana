# LiteSpeed / Apache cache rules for the SPA.
# Vite emits hashed filenames (assets/index-XXXX.js, assets/*.css) so those
# can be cached forever; index.html MUST NOT be cached or users get stuck on
# an old version that references deleted bundle hashes.

# ─── Disable LiteSpeed page cache (LSCache) for the SPA ───
# Without this, LiteSpeed will serve a cached copy of index.html for up to
# its configured TTL (often hours), ignoring file mtime and Cache-Control
# headers entirely. We bypass it so every request hits disk.
<IfModule LiteSpeed>
    CacheDisable public /
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_headers.c>
    # Long-lived immutable cache for hashed JS/CSS/font/img assets in /assets/
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # NEVER cache the HTML entry point — its content references hashed bundles
    # that change on each deploy.
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# SPA fallback — any path that isn't a real file goes to index.html so React
# Router can handle it. Skip for /api/* (proxied to Node.js by Passenger).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite real files / directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't rewrite API requests (Passenger handles those)
    RewriteRule ^api/ - [L]

    # Everything else → index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Compress text responses (HTML, JS, CSS, JSON) — typical CDN expects this.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
