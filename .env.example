# Frontend environment variables — exposed to the browser at build time.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Google OAuth Client ID (Web application type from Google Cloud Console).
# SAME value as backend/.env GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Google Maps Embed API key (https://console.cloud.google.com/).
# Enable "Maps Embed API" and restrict the key by HTTP referrer + by API.
# If empty, OfficesPage falls back to OpenStreetMap embeds.
VITE_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 Measurement ID (https://analytics.google.com/ → Admin →
# Data Streams → your web stream). Format: G-XXXXXXXXXX.
# If empty, no analytics data is sent (no-op).
VITE_GA_MEASUREMENT_ID=
